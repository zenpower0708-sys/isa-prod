                <h2 id="instructor-auth-title" class="game-font" style="color:var(--cyan);font-size:22px;">媛뺤궗 ?꾩슜 ?몄쬆</h2>
            </div>
            <div style="padding:16px 24px 0;">
                <p id="instructor-auth-desc" style="color:#e2e8f0;font-size:14px;line-height:1.6;margin:0;"></p>
            </div>

            <div style="padding:20px 24px 0;">
                <div class="form-group">
                    <label style="color:#94a3b8;font-size:12px;letter-spacing:1px;margin-bottom:8px;display:block;">?먭꺽利?踰덊샇 ?낅젰</label>
                    <div class="input-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
                        <input type="text" id="instructor-cert-input" placeholder="ISA-2026-000001"
                            style="width:100%;padding:14px 16px 14px 44px;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:white;font-family:monospace;letter-spacing:1px;outline:none;">
                    </div>
                </div>

                <div id="instructor-verify-result" style="margin-top:16px;min-height:40px;"></div>

                <button onclick="verifyInstructorCert()" class="btn-primary" style="width:100%;margin-top:20px;padding:14px;font-weight:800;font-size:15px;letter-spacing:1px;">
                    ?몄쬆?섍린
                </button>
            </div>

            <div style="margin:20px 24px 24px;background:rgba(6,182,212,0.05);border-radius:12px;padding:16px;border:1px solid rgba(6,182,212,0.15);">
                <p id="instructor-auth-note" style="font-size:12px;color:#64748b;line-height:1.6;margin:0;"></p>
            </div>
        </div>
    </div>

    <script src="data.js?v=20260430v1"></script>
    <script src="ai-manager.js?v=20260430v1"></script>
    <script src="app.js?v=20260430v1"></script>
    <script>
        let currentLoginMethod = 'email';
        function showEmailLogin() {
            currentLoginMethod = 'email';
            document.getElementById('login-options-view').style.display = 'none';
            document.getElementById('login-form-view').style.display = 'block';
            document.getElementById('login-sub').style.display = 'block';
            
            // ?꾨뱶 ?몄텧 蹂댁옣
            const loginFields = document.getElementById('login-fields-only');
            if (loginFields) loginFields.style.display = 'block';
            const signupFields = document.getElementById('signup-fields');
            if (signupFields) signupFields.style.display = 'none';
            const signupFieldsAfter = document.getElementById('signup-fields-after');
            if (signupFieldsAfter) signupFieldsAfter.style.display = 'none';
            
            document.getElementById('label-email').innerText = '?대찓??;
            document.getElementById('login-email').placeholder = 'surfer@isa.world';
            document.getElementById('login-email').type = 'email';
            
            // 濡쒓렇??紐⑤뱶濡?珥덇린??
            if (typeof isLoginMode !== 'undefined') isLoginMode = true;
            const title = document.getElementById('login-title');
            if (title) title.innerText = '濡쒓렇??;
            const btn = document.getElementById('login-submit-btn');
            if (btn) btn.innerText = '濡쒓렇??;
            const toggleText = document.getElementById('login-toggle-text');
            if (toggleText) toggleText.innerText = '怨꾩젙???놁쑝?좉??? ?뚯썝媛??;
        }
        function showMobileLogin() {
            currentLoginMethod = 'mobile';
            document.getElementById('login-options-view').style.display = 'none';
            document.getElementById('login-form-view').style.display = 'block';
            document.getElementById('login-sub').style.display = 'block';
            document.getElementById('label-email').innerText = '?대???踰덊샇';
            document.getElementById('login-email').placeholder = '010-0000-0000';
            document.getElementById('login-email').type = 'tel';
        }
        function backToLoginOptions() {
            document.getElementById('login-options-view').style.display = 'block';
            document.getElementById('login-form-view').style.display = 'none';
            document.getElementById('login-sub').style.display = 'none';
            document.getElementById('login-title').innerText = '濡쒓렇??;
            document.getElementById('signup-fields').style.display = 'none';
            const sfa = document.getElementById('signup-fields-after');
            if (sfa) sfa.style.display = 'none';
            document.getElementById('login-submit-btn').innerText = '濡쒓렇??;
            document.getElementById('login-toggle-text').innerText = '怨꾩젙???놁쑝?좉??? ?뚯썝媛??;
            if (typeof isLoginMode !== 'undefined') isLoginMode = true;
        }
        function startSignup() {
            showEmailLogin();
            if (typeof toggleLoginMode === 'function') {
                const title = document.getElementById('login-title');
                if (title.innerText === '濡쒓렇??) {
                    toggleLoginMode();
                }
            }
        }
    </script>
</body>
</html>


